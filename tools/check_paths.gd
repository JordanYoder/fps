@tool
extends EditorScript

# Finds broken file references after moving or renaming things.
# Run it from the Script editor with File > Run (Ctrl+Shift+X) while this script is open.
#
# Scans every script, scene and resource in the project for res:// paths and uid:// IDs and
# lists any that don't point at a real file. Results go to the Output panel.

const SCAN_EXTENSIONS: PackedStringArray = ["gd", "tscn", "tres", "godot", "cfg"]
## Folders that aren't ours to fix, or are regenerated by the editor
const SKIP_DIRS: PackedStringArray = ["res://.godot", "res://addons"]

var _regex := RegEx.new()
var _problems := 0
var _files_scanned := 0

func _run() -> void:
	# A res:// or uid:// reference, up to the closing quote, whitespace or bracket
	_regex.compile("(?:res|uid)://[^\"'\\s)\\]]+")
	_problems = 0
	_files_scanned = 0
	_scan_dir("res://")
	if _problems == 0:
		print("check_paths: all references OK (%d files scanned)" % _files_scanned)
	else:
		push_warning("check_paths: %d broken reference(s) in %d files scanned, see above" % [_problems, _files_scanned])

func _scan_dir(dir_path: String) -> void:
	if dir_path.trim_suffix("/") in SKIP_DIRS:
		return
	var dir := DirAccess.open(dir_path)
	if not dir:
		push_error("check_paths: can't open %s" % dir_path)
		return
	for sub in dir.get_directories():
		_scan_dir(dir_path.path_join(sub))
	for file in dir.get_files():
		if file.get_extension() in SCAN_EXTENSIONS:
			_scan_file(dir_path.path_join(file))

func _scan_file(file_path: String) -> void:
	var text := FileAccess.get_file_as_string(file_path)
	if text.is_empty():
		return
	_files_scanned += 1
	var lines := text.split("\n")
	for i in lines.size():
		for m in _regex.search_all(lines[i]):
			var ref := m.get_string()
			if not _exists(ref):
				_problems += 1
				printerr("%s:%d  missing  %s" % [file_path, i + 1, ref])

func _exists(ref: String) -> bool:
	if ref.contains("%") or ref.contains("{"):
		return true # Built with format() or %: can't check statically
	if ref.begins_with("uid://"):
		var id := ResourceUID.text_to_id(ref)
		return id != ResourceUID.INVALID_ID and ResourceUID.has_id(id)
	if ref == "res://" or ref.ends_with("/"):
		return DirAccess.dir_exists_absolute(ref)
	return FileAccess.file_exists(ref) or DirAccess.dir_exists_absolute(ref)
